# Copy to .env and fill in. .env is git-ignored — never commit real secrets.
# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dubai_congress

# JWT Secret — generate a real one for production: openssl rand -hex 32
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Congress Info — change these to update dates across the entire app
CONGRESS_NAME=Dubai Stem Cell Congress
CONGRESS_YEAR=2027
CONGRESS_DATES=Feb 15 – 17, 2027
CONGRESS_VENUE=Mövenpick Grand Al Bustan, Dubai
CONGRESS_DEADLINE=December 1, 2026

# "production" makes the app refuse to boot on a weak SECRET_KEY and marks
# the auth cookie Secure (HTTPS-only).
ENVIRONMENT=development
